# ============================================================
# FOXYN - variáveis de ambiente (copie para .env e preencha)
# ============================================================

# Porta do servidor
PORT=3000

# URL pública (usada em mensagens e callbacks). Deixe vazio em dev.
PUBLIC_URL=

# Segredo para assinar os JWTs. TROQUE por um valor longo e aleatório em produção!
JWT_SECRET=troque-este-segredo-por-um-valor-bem-longo-e-aleatorio

# Quanto tempo o token de login dura (padrão: 7 dias)
JWT_EXPIRES_IN=7d

# Notas sobre banco de dados:
#  - Local: o app usa SQLite em ./data/foxyn.db (autocriado).
#  - Produção (Render): use um PostgreSQL gerenciado e defina DATABASE_URL.
#    (O código aceita DATABASE_URL e usará o driver apropriado; por padrão usa SQLite.)
# DATABASE_URL=postgres://usuario:senha@host:porta/banco

# ------------------------------------------------------------
# Integrações EXTERNAS (opcionais) - vivem SOMENTE no servidor
# ------------------------------------------------------------

# API real de preços (Radar). Se vazio, usa dados locais de demonstração.
PRICE_API_URL=
PRICE_API_KEY=

# Chave secreta para verificar webhooks do gateway de pagamento.
# Se vazio, o checkout fica em modo "simulado" (dev).
PAYMENT_WEBHOOK_SECRET=

# Client/secret OAuth para login "Continuar com Google" (opcional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
